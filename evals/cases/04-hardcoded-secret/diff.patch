+import { API_KEY, FORM_ENDPOINT } from './config';
+
+export function buildPayload(name: string, message: string) {
+  return { name: name.trim(), message: message.trim() };
+}
+
+export async function submit(name: string, message: string) {
+  return fetch(FORM_ENDPOINT, {
+    method: 'POST',
+    headers: { Authorization: `Bearer ${API_KEY}`, 'Content-Type': 'application/json' },
+    body: JSON.stringify(buildPayload(name, message)),
+  });
+}
