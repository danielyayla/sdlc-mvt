+import { describe, expect, it } from 'vitest';
+import { formatPitch } from './formatPitch';
+
+describe('formatPitch', () => {
+  it('trims and capitalizes', () => {
+    expect(formatPitch('  ship with ai ')).toBe('Ship with ai');
+  });
+  it('returns empty for whitespace', () => {
+    expect(formatPitch('   ')).toBe('');
+  });
+  it('leaves an already-capitalized string alone', () => {
+    expect(formatPitch('Ship')).toBe('Ship');
+  });
+});
