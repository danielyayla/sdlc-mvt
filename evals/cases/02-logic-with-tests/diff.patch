+/** Trim whitespace and ensure the pitch starts with a capital letter. */
+export function formatPitch(input: string): string {
+  const trimmed = input.trim();
+  if (trimmed.length === 0) {
+    return '';
+  }
+  return trimmed[0].toUpperCase() + trimmed.slice(1);
+}
